# Copy to .env; never commit .env. Generate SECRET_KEY with secrets.token_hex(32).
SECRET_KEY=
DATABASE_PATH=instance/adaptolearn.sqlite3
HOST=127.0.0.1
PORT=5000
# Set 1 only when the application is served over HTTPS.
COOKIE_SECURE=0
# Resend is the default delivery provider. Store the API key only on the server.
MAIL_PROVIDER=resend
RESEND_API_KEY=
# Legacy SMTP settings below are unused when MAIL_PROVIDER=resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Microsoft 365: smtp.office365.com, 587, starttls, microsoft_oauth.
# SMTP_USERNAME and SMTP_FROM must be the same authorized sending mailbox.
# SMTP_PASSWORD is unused in microsoft_oauth mode; do not enter your work password.
SMTP_AUTH=password
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# Encrypted server-only MSAL token cache. Keep the session secret stable.
MICROSOFT_TOKEN_CACHE=instance/microsoft-mail-cache.bin
# Used only by scripts/manage.py setup-admin. Remove after initialization.
# Not required by seed-test-admin, which uses the server-only test_users.py registry.
ADMIN_INITIAL_PASSWORD=
# Required only when selecting one administrator from multiple existing admins.
ADMIN_OLD_EMAIL=
# 1 runs the announcement dispatcher every 20 seconds in the app process.
# Set 0 only if an external scheduler runs manage.py dispatch-announcements.
ANNOUNCEMENT_WORKER=1
